{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tasar",
      "destination": "https://ia-prop.vercel.app/"
    },
    {
      "source": "/tasar/:path*",
      "destination": "https://ia-prop.vercel.app/:path*"
    },
    {
      "source": "/buscar",
      "destination": "https://ia-prop.vercel.app/"
    },
    {
      "source": "/buscar/:path*",
      "destination": "https://ia-prop.vercel.app/:path*"
    },
    {
      "source": "/reels",
      "destination": "https://greatdeal-app-7b95.vercel.app/"
    },
    {
      "source": "/reels/:path*",
      "destination": "https://greatdeal-app-7b95.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
