{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tasar",
      "destination": "https://ia-prop.vercel.app/"
    },
    {
      "source": "/tasar/:path*",
      "destination": "https://ia-prop.vercel.app/:path*"
    },
    {
      "source": "/publicar",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/?modo=publicar"
    },
    {
      "source": "/publicar/:path*",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/:path*?modo=publicar"
    },
    {
      "source": "/comprar",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/"
    },
    {
      "source": "/comprar/:path*",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/:path*"
    },
    {
      "source": "/buscar",
      "destination": "/tasar"
    },
    {
      "source": "/reels",
      "destination": "/comprar"
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
