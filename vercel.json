{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "comment": "El home de 3 tarjetas salio: c2cprops.com entra directo al marketplace, que abre en Explorar. index.html queda en el repo por si hay que volver atras.",
      "source": "/",
      "destination": "https://comprar.c2cprops.com/",
      "permanent": false
    },
    {
      "source": "/tasar",
      "destination": "https://tasar.c2cprops.com/",
      "permanent": false
    },
    {
      "source": "/publicar",
      "destination": "https://vender.c2cprops.com/",
      "permanent": false
    },
    {
      "source": "/comprar",
      "destination": "https://comprar.c2cprops.com/",
      "permanent": false
    },
    {
      "source": "/vender",
      "destination": "https://vender.c2cprops.com/",
      "permanent": false
    },
    {
      "source": "/buscar",
      "destination": "/tasar",
      "permanent": false
    },
    {
      "source": "/reels",
      "destination": "/comprar",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
