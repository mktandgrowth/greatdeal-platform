{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tasar",
      "destination": "https://ia-prop.vercel.app/",
      "permanent": false
    },
    {
      "source": "/publicar",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/?modo=publicar",
      "permanent": false
    },
    {
      "source": "/comprar",
      "destination": "https://properties-app-mktandgrowth-5238s-projects.vercel.app/",
      "permanent": false
    },
    {
      "source": "/buscar",
      "destination": "/tasar",
      "permanent": false
    },
    {
      "source": "/reels",
      "destination": "/comprar",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
